# Copy to /var/www/homecoffee/backend/.env on the server and fill in every
# value marked CHANGE. Never commit the real file.

APP_NAME=HomeCoffee
APP_ENV=production
# php artisan key:generate fills this
APP_KEY=
APP_DEBUG=false
# CHANGE: your domain
APP_URL=https://homecoffee.example.com

# CHANGE: the address on the privacy policy and delete-account pages
CONTACT_EMAIL=
# CHANGE: who runs the app, as those pages should name it
APP_OPERATOR=HomeCoffee

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homecoffee
DB_USERNAME=homecoffee
# CHANGE: the MySQL password you created
DB_PASSWORD=

SESSION_DRIVER=database
# a barista's shift
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Sign-in codes and staff invites. Resend, Postmark and Mailgun all give
# SMTP details; Resend's free tier is enough for a portfolio app.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# CHANGE if you use another provider
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
# CHANGE: the provider's API key
MAIL_PASSWORD=
# CHANGE: an address on your verified domain
MAIL_FROM_ADDRESS="hello@homecoffee.example.com"
MAIL_FROM_NAME="HomeCoffee"

# Live order status. Laravel publishes to Reverb on this server directly;
# the app connects through nginx at wss://<your domain>/app.
BROADCAST_CONNECTION=reverb
# CHANGE: any number, e.g. 100001
REVERB_APP_ID=
# CHANGE: 20 random letters and digits
REVERB_APP_KEY=
# CHANGE: another 20 random letters and digits
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Nightly backups of the database and product photos to a bucket off the
# server. Cloudflare R2's free tier (10 GB) is plenty. Backups are zipped
# with this password: keep a copy of it somewhere other than the server.
BACKUP_DISKS=backups
# CHANGE: a long random password
BACKUP_ARCHIVE_PASSWORD=
# CHANGE: who hears about a failed backup
BACKUP_NOTIFY_EMAIL=
# CHANGE: R2 > Manage API tokens
BACKUP_ACCESS_KEY_ID=
# CHANGE
BACKUP_SECRET_ACCESS_KEY=
BACKUP_BUCKET=homecoffee-backups
BACKUP_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com   # CHANGE
BACKUP_REGION=auto

# "Your order is ready" pushes. Empty writes them to the log instead.
FCM_CREDENTIALS=
